{
  "name": "@yodaos-pkg/unfold",
  "version": "0.1.0",
  "description": "An AI-native server framework that renders UI and streams incremental updates across protocols.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "npm run build && npm run typecheck && tsx --test test/*.test.ts",
    "demo": "npm run build && tsx examples/ride/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:mcp": "tsx examples/ride/agent.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "negotiator": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^22.0.0",
    "hono": "^4.13.19",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
